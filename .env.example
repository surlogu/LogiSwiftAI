GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=your_gemini_api_key_here

# Model Right-Sizing (Independent RPM Quota Pools)
# Coordinator Agent (High-level reasoning & planning)
GEMINI_ROOT_MODEL=gemini-3.8-flash

# Sub-Agents & Multimodal Inspection (Lightweight, separate 15+ RPM quota pool)
GEMINI_LITE_MODEL=gemini-flash-lite-latest
